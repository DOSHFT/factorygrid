# Revelation Factory local environment.
# Copy to .env and fill secrets locally. Do not commit .env.

COMPOSE_PROJECT_NAME=factorygrid

# Pinned images from the live stack snapshot reviewed on 2026-05-17.
QDRANT_IMAGE=qdrant/qdrant@sha256:b3063c673f3973877c038eeecc392bad5011f072ee7892b56c9a8e204a3bdea9
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:7c311546c25e7bb6e8cafede9fcd3d0d622ac636b5c9418befaa32e85dfb0186
OPENHANDS_IMAGE=ghcr.io/all-hands-ai/openhands@sha256:00968de77a7b36546413e1f3b5c6b4e2c387d19ade54de7926e10f5b3d265fa6
NODE_BASE_IMAGE=node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

RUFLO_VERSION=3.7.0-alpha.44
CLAUDE_FLOW_CLI_VERSION=3.5.15

FACTORY_API_KEY=sk-change-me-local
TAVILY_API_KEY=

VLLM_HOST=http://host.docker.internal:18000
LITELLM_BASE_URL=http://litellm:4000/v1
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Temporal graph memory. Change NEO4J_PASSWORD in local .env before first start.
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=1G
GRAPHITI_NEO4J_URL=bolt://neo4j:7687
GRAPHITI_LLM_BASE_URL=http://litellm:4000/v1
GRAPHITI_LLM_MODEL=qwen-coder-14b
GRAPHITI_LLM_API_KEY=sk-change-me-local
GRAPHITI_EMBEDDING_BASE_URL=
GRAPHITI_EMBEDDING_MODEL=
GRAPHITI_EMBEDDING_API_KEY=

RUFLO_MCP_PORT=3010
RUFLOUI_API_PORT=28580
RUFLOUI_VITE_PORT=28589
RUFLOUI_HOST_BIND=0.0.0.0
OPENHANDS_PORT=3000

RUFLO_CLI_TIMEOUT=120000
RUFLO_OUTPUT_BUFFER_SIZE=1000
RUFLOUI_SKIP_PERMISSIONS=true
RUFLOUI_CORS_ORIGIN=http://localhost:28589
