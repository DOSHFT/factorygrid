{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": [
        "ruflo",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "5",
        "CLAUDE_FLOW_MEMORY_BACKEND": "memory"
      },
      "autoStart": false
    },
    "context-mode-eval": {
      "command": "context-mode",
      "args": [],
      "env": {
        "FACTORYGRID_ROOT": "/home/revelation/factorygrid"
      },
      "autoStart": false
    }
  }
}
