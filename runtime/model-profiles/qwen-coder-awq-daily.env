# Default coding/agent profile for local vLLM.
# Conservative on purpose: vLLM tends to reserve VRAM for KV cache/CUDA graphs.
PROFILE_NAME="qwen-coder-awq-daily"
ENGINE="vllm"
MODEL="Qwen/Qwen2.5-Coder-14B-Instruct-AWQ"
PORT=18000
GPU_MEM="0.50"
MAX_MODEL_LEN="8192"
MAX_NUM_SEQS="1"
MAX_BATCHED_TOKENS="8192"
SWAP_SPACE_GB="4"
QUANTIZATION="awq_marlin"
ENFORCE_EAGER="true"
