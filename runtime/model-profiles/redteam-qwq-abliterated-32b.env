# Red-team profile for operator-directed security work.
PROFILE_NAME="redteam-qwq-abliterated-32b"
ENGINE="vllm"
MODEL="${FACTORY_REDTEAM_VLLM_MODEL:-huihui-ai/QwQ-32B-abliterated}"
SERVED_MODEL_NAME="factory-active"
PORT=18000
GPU_MEM="${FACTORY_REDTEAM_GPU_MEM:-0.70}"
MAX_MODEL_LEN="${FACTORY_REDTEAM_MAX_MODEL_LEN:-8192}"
MAX_NUM_SEQS="${FACTORY_REDTEAM_MAX_NUM_SEQS:-1}"
MAX_BATCHED_TOKENS="${FACTORY_REDTEAM_MAX_BATCHED_TOKENS:-8192}"
SWAP_SPACE_GB="${FACTORY_REDTEAM_SWAP_SPACE_GB:-8}"
QUANTIZATION="${FACTORY_REDTEAM_QUANTIZATION:-none}"
ENFORCE_EAGER="true"
ROLE="redteam"
REQUIRES_ISOLATION="false"
AUTONOMOUS_TOOLS="true"
