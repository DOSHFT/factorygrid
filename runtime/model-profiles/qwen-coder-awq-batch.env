# Higher-throughput local vLLM profile for planned batch work only.
# Do not keep this running while using the Windows desktop heavily.
PROFILE_NAME="qwen-coder-awq-batch"
ENGINE="vllm"
MODEL="Qwen/Qwen2.5-Coder-14B-Instruct-AWQ"
SERVED_MODEL_NAME="factory-active"
PORT=18000
GPU_MEM="0.72"
MAX_MODEL_LEN="16384"
MAX_NUM_SEQS="2"
MAX_BATCHED_TOKENS="16384"
SWAP_SPACE_GB="4"
QUANTIZATION="awq_marlin"
ENFORCE_EAGER="true"
