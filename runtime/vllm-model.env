MODEL="Qwen/Qwen2.5-Coder-14B-Instruct-AWQ"
PORT=18000
GPU_MEM="0.72"
MAX_MODEL_LEN="22528"
MAX_NUM_SEQS="2"
MAX_BATCHED_TOKENS="22528"
SWAP_SPACE_GB="4"
QUANTIZATION="awq_marlin"
# Stability profile for RTX 4090 under WSL2. The previous 0.86/32k/4 profile
# left too little headroom and could crash the CUDA/vLLM engine under load.
# Tool calling support for Hermes / LiteLLM "auto" tool_choice (flags added to start-vllm-factory.sh):
# --enable-auto-tool-choice --tool-call-parser hermes
# Required because Hermes (and agents) use many MCP + built-in tools with auto selection.
# See Hermes chat error: "auto" tool choice requires --enable-auto-tool-choice and --tool-call-parser
